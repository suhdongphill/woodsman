// Woodsman 데이터 모델
// 주의: SQLite(로컬) / Cloudflare D1(운영) 대상이므로 enum·@db.Text를 쓰지 않는다.
//       상태·유형 값은 String으로 저장하고 zod(src/features/*/schema)에서 검증한다.

/// ⚠ **클라이언트 생성기를 두지 않는다.** Prisma는 이 프로젝트에서
///    **스키마 정의와 마이그레이션 생성** 도구로만 쓴다.
///
///    런타임 쿼리는 D1 바인딩을 직접 쓴다(`src/lib/d1.ts`). 이유:
///    OpenNext가 만든 Worker 번들에 Prisma의 WASM 쿼리 엔진이 포함되지 않아
///    첫 쿼리에서 죽는다(opennextjs-cloudflare #471 / prisma #23457, 2026-08 미해결).
///    바이너리 엔진(prisma-client-js)은 Workers에 실행 파일이 없어 애초에 불가능하다.
///
///    이 파일은 여전히 **스키마의 원본**이다. 컬럼을 바꾸면
///    `npm run db:migrate`로 마이그레이션을 만들고, 쿼리는 각 기능의 repository에서 고친다.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── 인증 ───────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?

  /// 자체 로그인(Credentials)용 해시. 소셜 전용 계정은 null.
  passwordHash String?
  /// ADMIN | USER
  role         String  @default("USER")

  accounts  Account[]
  sessions  Session[]
  comments  Comment[]
  portfolio Portfolio?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ────────────── 관리자 대표(모델) 포트폴리오: 공개 ──────────────

model ModelHolding {
  id     String  @id @default(cuid())
  name   String
  ticker String?
  market String?

  /// GROWTH | INCOME | DEFENSE
  functionType String

  targetWeight Float?
  avgCost      Float?
  shares       Float?
  /// KRW | USD
  currency     String @default("KRW")

  /// 현재가 — ⚠ **관리자가 손으로 넣는 값**이다. 실시세 연동은 아직 없다(P6/P7).
  price     Float?
  /// 위 `price`를 적어 넣은 기준일. ⚠ 값이 있는 화면에는 이 날짜를 반드시 같이 보여준다.
  ///    날짜 없이 숫자만 두면 자동으로 갱신되는 시세처럼 읽힌다.
  priceAsOf DateTime?

  /// 편입 논리 (sanitize된 HTML 또는 텍스트)
  thesis  String?
  canslim Float?
  blogUrl String?

  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
  @@index([functionType])
}

model Rebalance {
  id        String   @id @default(cuid())
  date      DateTime
  memo      String
  createdAt DateTime @default(now())

  @@index([date])
}

/// 계좌 스냅샷 — "원금 대비 평가액" 곡선의 한 점.
/// 운용자가 자기 계좌를 공개하는 콘텐츠이므로, 판단(JournalEntry)과 결과(여기)를
/// 같은 시간축에 올려 원칙대로 한 투자가 실제로 성과를 냈는지 보여준다.
model AccountSnapshot {
  id String @id @default(cuid())

  /// 스냅샷 기준일 (월 1회 기록을 기본으로 한다)
  date DateTime @unique

  /// 그날까지 넣은 순수 납입원금 누계
  principal Float
  /// 그날의 총 평가액
  value     Float
  /// 누적 배당·이자 (평가액과 별개로 따로 보여 준다)
  income    Float @default(0)

  memo      String?
  createdAt DateTime @default(now())

  @@index([date])
}

/// 투자일지 — 매수·매도·리밸런싱·관찰 기록. 브이로그처럼 시간순으로 쌓인다.
model JournalEntry {
  id   String   @id @default(cuid())
  date DateTime

  /// BUY | SELL | REBALANCE | NOTE
  action String

  title String
  /// 근거·판단 (sanitize된 HTML 또는 텍스트)
  body  String

  /// 관련 종목 (선택)
  ticker String?
  name   String?

  /// 체결 정보 (선택 — NOTE에는 없다)
  shares   Float?
  price    Float?
  currency String? @default("KRW")

  /// 연결 인사이트 글 slug (선택)
  postSlug String?

  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date])
  @@index([ticker])
}

// ────────────── 콘텐츠(관리자 전용 작성) ──────────────

model Post {
  id   String @id @default(cuid())
  slug String @unique

  /// INSIGHT | ANALYSIS | NOTICE
  type     String
  category String?

  title   String
  excerpt String?

  /// 작성 원본. ⚠ 사람이 고치는 것은 이 값이다.
  body     String?
  /// MARKDOWN | HTML — `body`를 어떤 형식으로 썼는지
  format   String  @default("MARKDOWN")
  /// 화면에 나가는 HTML. `body`를 변환·정화한 **결과 캐시**다.
  /// ⚠ 여기에 직접 쓰지 않는다. 저장할 때 `body`에서 다시 만든다
  ///    (직접 쓰면 정화를 건너뛴 HTML이 화면에 꽂힌다).
  bodyHtml String?

  /// 이 글이 어느 화면 묶음에 쌓일지: HOME | MACRO | PORTFOLIO | JOURNAL | INSIGHT
  /// 발행할 때마다 해당 섹션 프레임에 한 편씩 더해진다.
  section String @default("INSIGHT")

  thumbnailUrl String?

  /// SELF | TISTORY
  source      String  @default("SELF")
  /// 티스토리 원문 URL
  externalUrl String?
  /// 연결 종목(선택)
  ticker      String?
  /// CSV: "반도체,1등주"
  tags        String?

  /// 글별 댓글 on/off (🔒)
  commentsEnabled Boolean @default(true)

  published   Boolean   @default(false)
  viewCount   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments Comment[]

  @@index([published, publishedAt])
  @@index([type])
  @@index([ticker])
  @@index([section, published, publishedAt])
}

// ────────────── 댓글 ──────────────

model Comment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  authorName String?
  body       String

  /// VISIBLE | PENDING | HIDDEN
  status   String  @default("VISIBLE")
  reported Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([postId, status])
  @@index([status, reported])
  @@index([userId])
}

// ────────────── 사이트/댓글 전역 설정 ──────────────

model SiteConfig {
  id String @id @default("singleton")

  /// 공개 회원가입을 받을지. 지금은 운영자 1인 블로그라 기본 false.
  /// 커뮤니티 코드는 남겨 두고 이 스위치로만 연다 — src/lib/site-policy.ts 참고.
  signupEnabled    Boolean @default(false)
  /// 게시판·커뮤니티 노출 여부. 기본 false.
  communityEnabled Boolean @default(false)

  commentsGloballyEnabled Boolean @default(true)
  requireLoginToComment   Boolean @default(true)
  /// 승인 후 노출
  moderationOn            Boolean @default(false)
  /// CSV
  bannedWords             String?

  heroTitle    String?
  heroSubtitle String?

  /// PAPER | LIVE — 모의 투자인지 실계좌인지.
  /// 매매·납입은 가상이어도 종목 시세는 실제라, "무엇이 가상이고 무엇이 실제인지"를 화면에 밝힌다.
  /// ⚠ 기본값은 PAPER. 읽지 못했을 때 실계좌로 보이면 공신력이 무너진다.
  /// src/lib/data-mode.ts 참고.
  dataMode String @default("PAPER")

  /// 문의 메일 — 비어 있으면 코드의 기본값(src/lib/site-links.ts)을 쓴다
  contactEmail String?

  /// USD→KRW 환산율. ⚠ 원화·달러 종목을 한 축에서 비교하려면 반드시 필요하다.
  /// 없으면 달러 종목이 원화 종목에 파묻혀 비중이 통째로 틀린다(실제로 그랬다).
  /// 실시간 시세가 아니라 운영자가 지정하는 기준 환율이고, 화면에 그렇게 밝힌다.
  usdKrwRate Float @default(1350)

  /// 티스토리 — 대문 · 대표 글 · RSS. 처음 개발할 때 코드에 박아 둔 값을 화면에서 고칠 수 있게 한다.
  tistoryBlogUrl     String?
  tistoryFeaturedUrl String?
  tistoryRssUrl      String?

  /// 대표 글을 URL이 아니라 '콘텐츠'로 보여주기 위한 제목·요약.
  /// 주소를 그대로 노출하면 읽는 사람에게 아무 정보가 없다.
  featuredTitle   String?
  featuredExcerpt String?

  updatedAt DateTime @updatedAt
}

// ────────────── AI 제공자 (무료 우선 폴백) ──────────────

model AiProvider {
  id   String @id @default(cuid())
  /// 표시명 (예: NVIDIA NIM, Groq, Claude)
  name String @unique

  /// ANTHROPIC | OPENAI_COMPAT
  kind    String
  /// OPENAI_COMPAT 엔드포인트
  baseUrl String?
  model   String

  /// 키가 담긴 env 변수명. 키 '값'은 DB에 저장하지 않는다.
  apiKeyEnv String

  free     Boolean @default(false)
  enabled  Boolean @default(true)
  /// 폴백 순서(작을수록 우선)
  priority Int     @default(0)

  monthlyTokenCap     Int?
  tokensUsedThisMonth Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, priority])
}

model AiConfig {
  id String @id @default("singleton")

  /// AI 실행 주체: ADMIN | USER
  allowedRole           String @default("ADMIN")
  cacheTtlHours         Int    @default(24)
  globalMonthlyTokenCap Int    @default(1000000)
  tokensUsedThisMonth   Int    @default(0)

  updatedAt DateTime @updatedAt
}

model AiCache {
  id        String   @id @default(cuid())
  key       String   @unique
  payload   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 아웃바운드 클릭 집계 — "티스토리로 몇 명이 넘어갔나".
/// 이 사이트의 1순위 목적이 블로그 트래픽 유도라 성과 지표가 된다.
/// 개인 식별 정보(IP·UA·쿠키)는 저장하지 않고 날짜별 합계만 센다.
model OutboundClick {
  id String @id @default(cuid())

  /// 대상 키 (src/lib/outbound.ts의 OUTBOUND_TARGETS)
  target String
  /// 집계 날짜 (KST 기준 YYYY-MM-DD)
  date   String
  count  Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([target, date])
  @@index([date])
}

// ────────────── 외부 블로그 RSS ──────────────

model Feed {
  id            String    @id @default(cuid())
  name          String
  url           String    @unique
  active        Boolean   @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([active])
}

// ────────────── 개인 포트폴리오 (비공개, Phase 8) ──────────────

model Portfolio {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  holdings  Holding[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Holding {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  ticker   String
  name     String
  avgCost  Float
  shares   Float
  /// KRW | USD
  currency String  @default("KRW")
  industry String?
  /// 확대 | 유지 | 축소
  weight   String?
  /// 투자 아이디어(기존 앱 investIdea)
  memo     String?

  addedAt DateTime @default(now())

  @@index([portfolioId])
}

// ────────────── 거시 지표(매크로) ──────────────

/// 거시 지표의 시계열 한 점.
///
/// ⚠ **지표의 정의는 여기 없다.** 이름·출처·임계값·설명은 `src/lib/macro/catalog.ts`가
///    원본이다(코드 = 카탈로그, DB = 값). 여기에는 `seriesKey`(카탈로그의 key)와
///    날짜·원값만 쌓는다.
///
/// ⚠ 값은 **원값(level)** 그대로 넣는다. YoY·전월비 같은 변환은 읽을 때 한다
///    (`lib/macro/series.ts`). 가공해서 저장하면 규칙이 바뀔 때 되돌릴 수 없다.
model MacroPoint {
  seriesKey String
  /// 관측 기준일. 날짜만 있는 값이므로 정오(UTC)로 저장한다.
  date      DateTime
  value     Float

  /// FRED | YAHOO | MANUAL — 이 값이 어디서 왔는지. 수동 입력을 나중에 구분해야 한다.
  source    String
  /// 수집 시각(같은 날짜를 다시 받으면 갱신된다 — 통계는 사후 수정된다)
  updatedAt DateTime @default(now())

  @@id([seriesKey, date])
  @@index([seriesKey, date])
}

/// 자료 가져오기 실행 기록.
///
/// ⚠ 조용한 실패를 막으려고 둔다. 지표 하나가 계속 실패해도 화면은 옛 값을 그대로
///    보여주기 때문에, **어디까지 성공했는지 남기지 않으면 아무도 모른다.**
model MacroIngest {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// MANUAL(관리자 버튼) | CRON
  trigger String @default("MANUAL")

  okCount     Int @default(0)
  failCount   Int @default(0)
  /// 새로 쌓인 점의 개수
  addedPoints Int @default(0)

  /// 지표별 결과 JSON — 실패 사유를 그대로 남긴다
  detail String?

  @@index([startedAt])
}

// ────────────── AI·반도체 버블 모니터 ──────────────

/// 지표 하나의 판정. ⚠ 레이어·가중치·임계값 정의는 `src/lib/bubble/catalog.ts`가 원본이다.
model BubbleReading {
  /// 카탈로그의 지표 키
  indicatorKey String    @id
  /// 0 | 1 | 2 — ⚠ 소수점을 두지 않는다(정성 지표에 없는 정밀도가 생긴다)
  points       Int
  /// 근거가 된 숫자·문장
  value        String?
  /// 기준일
  asOf         DateTime?
  note         String?
  updatedAt    DateTime  @updatedAt
}

/// 하드 트리거의 현재 상태(발화 여부·근접도·지금 상황).
model BubbleTriggerState {
  triggerKey String    @id
  fired      Boolean   @default(false)
  /// far | near
  proximity  String    @default("far")
  now        String?
  asOf       DateTime?
  updatedAt  DateTime  @updatedAt
}

/// 페이지 조회 집계.
///
/// ⚠ **(경로, 날짜, 합계)만** 쌓는다. 쿠키·IP·UA·리퍼러를 저장하지 않는다
///    (`/privacy`의 "회원정보를 수집하지 않는다"와 같은 선, OutboundClick과 같은 규칙).
///    개인을 구분하지 않으므로 **방문자 수(UV)가 아니라 조회수(PV)**다. 화면에도 그렇게 적는다.
model PageView {
  id String @id @default(cuid())

  /// 정규화된 경로 (쿼리스트링 제거 — src/lib/analytics.ts)
  path  String
  /// 집계 날짜 (KST 기준 YYYY-MM-DD)
  date  String
  count Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([path, date])
  @@index([date])
  @@index([path])
}

/// 화면 체류·읽힘 집계 — "화면을 어떻게 고칠까"에 답하기 위한 표.
///
/// ⚠ PageView와 **같은 개인정보 규칙**을 따른다. 쿠키·IP·UA·리퍼러를 저장하지 않고
///    (경로, 날짜, 집계)만 쌓는다. 개인의 세션을 잇지 않으므로 "이 사람이 어디로 갔나"는
///    낼 수 없다. 낼 수 있는 것은 **"이 화면이 평균적으로 어떻게 소비되나"**까지다.
///
/// ⚠ 왜 평균이 아니라 버킷인가: 체류시간 평균은 탭을 열어 두고 자리를 뜬 한 명이 통째로
///    끌어올린다. 구간별 인원으로 쌓으면 그 한 명이 한 칸에 갇힌다(`src/lib/engagement.ts`).
/// ⚠ 버킷 경계를 바꾸면 과거 데이터와 비교가 깨진다. 바꿔야 하면 새 열을 만든다.
model PageEngagement {
  id String @id @default(cuid())

  /// 정규화된 경로 (PageView와 같은 규칙)
  path String
  /// 집계 날짜 (KST 기준 YYYY-MM-DD)
  date String

  /// 체류시간을 보고한 표본 수. ⚠ 조회수와 다르다 — 비콘이 못 간 이탈이 있다
  samples Int @default(0)

  /// 체류시간 구간별 인원 (0: 5초 미만 … 6: 5분 이상)
  dwell0 Int @default(0)
  dwell1 Int @default(0)
  dwell2 Int @default(0)
  dwell3 Int @default(0)
  dwell4 Int @default(0)
  dwell5 Int @default(0)
  dwell6 Int @default(0)

  /// 스크롤 깊이 구간별 인원 (0: 25% 미만 … 4: 끝까지)
  scroll0 Int @default(0)
  scroll1 Int @default(0)
  scroll2 Int @default(0)
  scroll3 Int @default(0)
  scroll4 Int @default(0)

  /// 시간(30초)·깊이(50%)를 **둘 다** 넘은 표본 수
  reads Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([path, date])
  @@index([date])
  @@index([path])
}

/// 아웃바운드 클릭이 **어느 화면에서** 났는지.
///
/// 1순위 목적(티스토리 유입)의 개선은 "몇 번 나갔나"가 아니라 **"어느 화면이 내보내나"**를
/// 알아야 가능하다. OutboundClick(대상·날짜)은 그대로 두고, 출처 화면별 집계를 따로 쌓는다.
/// ⚠ 여기 들어오는 경로도 `analytics.normalizePath`를 통과한 값만이다.
model OutboundSource {
  id String @id @default(cuid())

  /// 클릭이 일어난 화면의 정규화 경로
  path   String
  /// 대상 키 (src/lib/outbound.ts)
  target String
  /// 집계 날짜 (KST 기준 YYYY-MM-DD)
  date   String
  count  Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([path, target, date])
  @@index([date])
  @@index([path])
}

// ────────────── 종목분석 보고서 ──────────────
//
// ⚠ 섹션 구성·정직성 규율은 `src/lib/report/catalog.ts`가 원본이다.
//    거시·버블·CANSLIM과 같은 원칙 — **코드가 구조, DB는 내용.**
//    바뀌는 것은 보고서 내용이지 섹션 목록이나 규율이 아니다.
//
// ⚠ 발행 전 규율 검증은 `src/lib/report/rules.ts`가 한다. 스키마는 값을 **담을 수 있게만**
//    하고(대부분 nullable), "없으면 발행 불가"는 검증기가 판정한다.
//    DB 제약으로 막으면 초안을 저장하다 말 수 없다 — 쓰다 만 초안도 저장돼야 한다.

/// 보고서 한 건. 종목 하나당 **현재 버전 하나**만 D1에 둔다.
/// 과거 발행본 스냅샷은 R2에 둘 계획이다(설계서 §7-2). 아직 구현 전.
model StockReport {
  /// ⚠ **문자열로만** 다룬다. 숫자로 파싱하면 `005930` → `5930`이 되어 국내 종목이 사라진다.
  ticker String @id

  name     String
  /// US | KR — ⚠ 시장 하나 = 어댑터 하나. 한 코드로 두 시장을 처리하지 않는다(설계서 §5-2)
  market   String
  industry String?
  currency String  @default("USD")

  /// DRAFT | PUBLISHED — ⚠ 공개 화면은 PUBLISHED만 읽는다
  status  String @default("DRAFT")
  /// 발행 회차. 발행할 때마다 오른다
  version Int    @default(1)

  /// 한 줄 논지(§00 헤더·목록에 쓰인다)
  headline String

  /// 구조 판정(중장기). ⚠ 철회 조건과 짝이다
  verdictStructural String?
  /// 단기 판정. ⚠ 시계를 분리해 적는다 — 두 판정이 모순돼 보이지 않게
  verdictShort      String?
  /// ⚠ R3 — 판정의 공식 철회 조건. 반증 조건 없는 판정은 소감이다
  revokeIf          String?

  /// ⚠ R6 — 밸류에이션 방법론의 한계. 신뢰는 결론이 아니라 한계 고백에서 나온다
  valuationLimitation String?

  /// ⚠ R7 — 다음 판단 시점. 날짜만 있는 값은 정오(UTC)로 저장한다
  nextCheckAt DateTime?

  /// ⚠ R4 — **제3자(증권사)가 공표한** 목표주가다. 우리가 산출한 값이 아니다.
  ///    `WOODSMAN_DOCTRINE`이 금지하는 것은 우리가 제시하는 것이고,
  ///    출처·기준일과 함께 옮기는 것은 사실 보도다. 그래서 출처 칸이 값과 한 묶음이다.
  consensusTarget   Float?
  consensusCurrency String?
  consensusSource   String?
  consensusAsOf     DateTime?
  consensusUrl      String?

  /// 이 보고서를 옮겨 실은 티스토리 글 주소.
  /// ⚠ 사이트의 1순위 목적은 **티스토리로 트래픽을 보내는 것**이다(운영지침 §5).
  ///    값이 있으면 공개 화면이 `/go/stock-<ticker>` 경유 CTA를 띄우고 클릭을 센다.
  /// ⚠ 저장 전에 반드시 `site-basics.sanitizeUrl`을 거친다 —
  ///    정화되지 않은 문자열이 들어오면 우리 도메인이 피싱 경유지가 된다.
  tistoryUrl String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  blocks    StockReportBlock[]
  items     StockReportItem[]
  checklist StockChecklistItem[]
  context   StockReportContext?

  @@index([status])
  @@index([market])
}

/// 섹션 하나의 본문.
///
/// ⚠ 본문 저장 경로는 **하나뿐이다**: 원본(`body`) → `lib/markdown` → `lib/sanitize-html`
///    → `bodyHtml`. 글(Post)과 같은 규칙이다. `bodyHtml`에 직접 쓰지 않는다.
model StockReportBlock {
  id     String @id @default(cuid())
  ticker String

  /// `lib/report/catalog.ts`의 섹션 키. ⚠ 발행 뒤에는 키 이름을 바꾸지 않는다
  sectionKey String

  /// 마크다운 원본
  body     String @default("")
  /// 변환·정화를 거친 결과. 화면은 이것만 읽는다
  bodyHtml String @default("")

  /// confirmed | needsCheck | na — ⚠ R5. 수치 섹션은 필수다
  tag        String?
  source     String?
  sourceUrl  String?
  /// 기준일(정오 UTC)
  asOf       DateTime?
  /// ⚠ R2 — 비어 있는 칸의 **조회처**. 추정치로 채우는 대신 어디서 구하는지 적는다
  lookupHint String?

  updatedAt DateTime @updatedAt

  report StockReport @relation(fields: [ticker], references: [ticker], onDelete: Cascade)

  @@unique([ticker, sectionKey])
  @@index([ticker])
}

/// CANSLIM 한 축의 채점.
///
/// ⚠ `points`가 **null이면 N/A**다. 0점이 아니라 **분모에서 빠진다**(R1).
///    기본값 0을 두지 않는 이유가 이것이다 — 0을 넣는 순간 "안 본 것"이 "나쁜 것"이 된다.
model StockReportItem {
  id     String @id @default(cuid())
  ticker String

  /// C | A | N | S | L | I | M
  itemKey String
  /// 0~10. ⚠ null = N/A
  points  Int?
  /// confirmed | needsCheck | na
  tag     String @default("na")

  /// 근거 한 줄 — 숫자가 들어가야 한다
  evidence  String?
  source    String?
  sourceUrl String?
  asOf      DateTime?

  updatedAt DateTime @updatedAt

  report StockReport @relation(fields: [ticker], references: [ticker], onDelete: Cascade)

  @@unique([ticker, itemKey])
  @@index([ticker])
}

/// §11 미확정 체크리스트 한 줄 — 그대로 다음 갱신의 작업 목록이 된다(R7).
model StockChecklistItem {
  id     String @id @default(cuid())
  ticker String

  /// 무엇을 모르나
  item   String
  /// 어디서 확인하나
  source String
  /// 확인되면 무엇이 바뀌나
  impact String
  order  Int    @default(0)

  report StockReport @relation(fields: [ticker], references: [ticker], onDelete: Cascade)

  @@index([ticker])
}

/// 보고서를 쓸 때 **사이트가 이미 알고 있던 것**의 스냅숏 — 거시·버블·대표 포트폴리오.
///
/// ## ⚠ 왜 실시간이 아니라 스냅숏인가
/// 보고서는 날짜가 박힌 문서다. §01 논지가 "버블 56점(경계)"를 근거로 쓰였는데 화면이
/// 오늘 값 72를 띄우면 같은 문서가 스스로와 모순된다. 그래서 주입 시점 값을 얼려 두고,
/// 지금 값과의 차이는 **편집 화면에서만** 말한다(`lib/report/context.ts`의 `describeDrift`).
/// 그 차이가 곧 R7(다음 판단 시점)의 재료다.
///
/// ⚠ 값이 아니라 **판정 문자열까지** 같이 저장한다(recessionLabel·bubbleRegime).
///    판정 규칙이 나중에 바뀌면 옛 보고서의 근거 문장과 화면이 어긋나기 때문이다.
/// ⚠ 트리거는 **키만** 담는다(`trg1,trg5`). 문장의 원본은 `lib/bubble/catalog.ts`다.
model StockReportContext {
  /// 보고서 하나에 스냅숏 하나. 갈아 끼울 뿐 쌓지 않는다
  ticker String @id

  /// 언제 뜬 스냅숏인가(정오 UTC). ⚠ 이 날짜가 없으면 스냅숏은 그냥 옛 숫자다
  capturedAt DateTime

  /// calm | watch | caution | danger | unknown
  recessionLevel    String?
  recessionLabel    String?
  recessionLine     String?
  recessionAlerts   Int?
  recessionWatches  Int?
  recessionUnknowns Int?
  recessionTotal    Int?
  /// 거시 지표 전체에서 가장 최근 기준일
  macroAsOf         DateTime?

  /// hawkish | neutral | dovish. ⚠ 필수 셋이 없으면 계산 자체가 없어 전부 null이다
  fedBias      String?
  fedBiasLabel String?
  fedHike      Float?
  fedHold      Float?
  fedCut       Float?
  /// ⚠ 입력 지표 중 **가장 오래된** 기준일 — 묵은 판단을 새 것으로 보이게 하지 않는다
  fedAsOf      DateTime?

  /// 0~100. ⚠ null = 미채점. 0으로 저장하지 않는다(0은 "안전"으로 읽힌다)
  bubbleScore         Float?
  bubbleRegime        String?
  bubbleStance        String?
  bubbleScored        Int?
  bubbleTotal         Int?
  bubblePriorityFired Boolean @default(false)
  /// 발화한 하드 트리거 키를 쉼표로 이은 것. 빈 문자열이면 없음
  bubbleFired         String  @default("")

  inPortfolio   Boolean @default(false)
  functionType  String?
  targetWeight  Float?
  holdingThesis String?

  /// ── 시세 (§02 히어로 KPI). ⚠ null = 미수집. 0으로 저장하지 않는다
  quotePrice          Float?
  /// 그 종가의 거래일. 날짜만 있는 값이므로 정오(UTC)로 저장한다
  quoteAsOf           DateTime?
  quoteCurrency       String?
  /// 전일 대비 %
  quoteChangePercent  Float?
  quoteLow52          Float?
  quoteHigh52         Float?
  /// 52주 밴드 안의 위치 0~100. ⚠ 밴드 폭이 0이면 null이다(0%는 "52주 저점"이라는 거짓말이 된다)
  quotePosition52     Float?
  /// 52주 범위를 실제로 몇 개 점에서 냈나 — 얇으면 화면이 그렇게 말한다
  quoteRangeSamples   Int?
  /// 일평균 대비 거래량 배수
  quoteVolumeMultiple Float?
  /// ⚠ 국내 종목처럼 덜 믿을 값일 때의 한 문장. 조용히 같은 굵기로 보이면 안 된다
  quoteCaveat         String?

  /// ── Envelope (§09). ⚠ **밴드 위치까지만.** 대응(매수/손절)은 사람이 쓴다
  envMiddle    Float?
  envUpper     Float?
  envLower     Float?
  /// 0=하단 · 50=중심 · 100=상단. ⚠ 벗어나면 범위 밖 값을 그대로 저장한다
  envPosition  Float?
  /// 중심선 대비 괴리율 %
  envDeviation Float?
  /// 계산에 쓴 주 수. 20보다 적으면 화면이 그렇게 말한다
  envWeeks     Int?

  updatedAt DateTime @updatedAt

  report StockReport @relation(fields: [ticker], references: [ticker], onDelete: Cascade)
}

// ────────────── 종목 시세 (§02 히어로 KPI · §09 Envelope) ──────────────

/// 종목 하나의 하루 종가.
///
/// ⚠ **`Stock` 테이블을 따로 두지 않았다.** 종목의 이름·시장·통화는 이미 `StockReport`가
///    갖고 있다(계획서 C1은 둘로 나눌 것을 적었지만, 지금 시세가 필요한 것은 보고서뿐이라
///    같은 사실을 두 곳에 두면 어긋난다). 보고서 없는 종목의 시세가 필요해지면 그때 나눈다.
///
/// ⚠ ticker는 **문자열로만** 다룬다. 숫자로 파싱하면 `005930` → `5930`이 되어 국내 종목이 사라진다.
model StockQuote {
  ticker String
  /// 거래일. 날짜만 있는 값이므로 정오(UTC)로 저장한다(`MacroPoint`와 같은 규칙).
  date   DateTime

  close  Float
  /// ⚠ 거래량은 없을 수 있다. **없는 것과 0은 다르다** — 배수 계산에서 갈린다.
  volume Float?

  /// YAHOO | MANUAL — 어디서 온 값인지. 나중에 국장 어댑터가 붙으면 늘어난다(설계서 §5-2)
  source String @default("YAHOO")

  /// 수집 시각(같은 날짜를 다시 받으면 갱신된다 — 종가도 사후 수정된다)
  updatedAt DateTime @default(now())

  @@id([ticker, date])
  @@index([ticker, date])
}

/// 시세 가져오기 실행 기록.
///
/// ⚠ `MacroIngest`와 같은 이유로 둔다. 수집이 멈춰도 화면은 옛 종가를 그대로 보여주므로,
///    **어디까지 성공했는지 남기지 않으면 멈춘 줄도 모른다.**
model StockQuoteIngest {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// MANUAL(관리자 버튼) | CRON
  trigger String @default("MANUAL")

  okCount     Int @default(0)
  failCount   Int @default(0)
  /// 새로 쌓인 점의 개수
  addedPoints Int @default(0)

  /// 종목별 결과 JSON — 실패 사유를 그대로 남긴다
  detail String?

  @@index([startedAt])
}

// ────────────── 포트폴리오 대분류 버킷 ──────────────

/// 대표 포트폴리오의 **대분류 카테고리와 목표 구성비**.
///
/// ⚠ 2026-08-17 이전에는 성장·인컴·방어가 `FunctionType` 유니온으로 **코드에 박혀** 있었고,
///    버킷 목표비중은 보유 종목의 `targetWeight` 합계로 **파생**되고 있었다. 그래서
///    "목표를 정해 두고 아직 아무것도 안 샀다"를 표현할 수 없었고, 운영 전략이 바뀌어도
///    관리자가 분류를 손댈 수 없었다. 운영지침의 설계사상(모든 것은 admin이 유연하게 운영한다)에
///    어긋나 데이터로 내렸다. 판단·검증은 `src/lib/bucket-target.ts`가 한다.
model PortfolioBucket {
  /// ⚠ 안정된 식별자. `ModelHolding.functionType`·`StockReportContext.functionType`이
  ///    이 값을 참조하므로 **만든 뒤 바꾸지 않는다.** 기본 셋은 GROWTH · INCOME · DEFENSE
  key String @id

  /// 화면에 보이는 이름. 관리자가 바꿀 수 있다(키는 그대로 두므로 옛 데이터가 안 끊긴다)
  name        String
  /// 공개 화면의 한 줄 설명
  description String?

  /// 목표 구성비(%). ⚠ 합계는 100 **이하**를 허용한다 — 남는 몫이 현금·미배정이다
  targetPct Float @default(0)

  /// 차트·배지 색 (#RRGGBB). ⚠ 임의 문자열이 style에 들어가지 않게 검증한다
  color String @default("#5b7fa6")

  /// 표시 순서. 작을수록 앞
  sortOrder Int @default(0)

  /// ⚠ 기본 셋인가. 기본 셋의 **키는 지울 수 없다** — AI 프롬프트 용어(`lib/ai/labels.ts`)와
  ///    시드·기존 보고서가 참조한다. 안 쓰겠다면 목표 비중을 0%로 둔다.
  builtIn Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}
