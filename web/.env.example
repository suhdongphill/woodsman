# ─────────────────────────────────────────────────────────────
# Woodsman 환경변수 — 전부 "서버 전용"입니다.
# NEXT_PUBLIC_ 접두사를 붙이지 마세요(붙이면 브라우저로 노출됩니다).
# `npm run setup`이 이 파일을 참고해 .env를 만들고 비어 있는 값을 채웁니다.
# ─────────────────────────────────────────────────────────────

# SQLite 파일 경로. prisma/schema.prisma 기준 상대경로 → web/prisma/dev.db
DATABASE_URL="file:./dev.db"

# Auth.js 세션 서명 키 (setup이 자동 생성)
AUTH_SECRET=""

# 운영 배포 시 서비스 정식 주소(예: https://woodsman.example.com).
# 로컬은 비워두면 됩니다. 값을 넣으면 소셜 로그인 콜백 URL이 Host 헤더에 휘둘리지 않습니다.
AUTH_URL=""

# 검색엔진에 알릴 정식 주소. 비워두면 robots.txt가 "전체 색인 금지"로 동작합니다.
# (도메인이 정해지기 전에 미리보기 주소가 색인되는 걸 막기 위한 기본값입니다.)
SITE_URL=""

# ── 자동 수집 (배포본에만 필요) ──
# Cron Trigger가 매일 06:00(KST)에 /api/cron 을 두드릴 때 쓰는 값입니다. 32자 이상.
# ⚠ 로컬에는 없어도 됩니다. 배포본에는 `npx wrangler secret put CRON_SECRET`으로 넣습니다.
#    없으면 스케줄이 돌아도 아무것도 하지 않고 로그에만 남습니다(문을 열어 두지 않습니다).
# 값 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# ── 인증키 보관함 마스터 키 (권장) ──
# 관리자 화면에서 등록한 API 키를 암호화해 DB에 넣을 때 씁니다. 32자 이상.
# ⚠ 없으면 AUTH_SECRET에서 파생합니다 — 그 경우 AUTH_SECRET을 바꾸면 저장된 키를 다시 넣어야 합니다.
# 값 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 배포본: npx wrangler secret put KEY_ENCRYPTION_KEY
KEY_ENCRYPTION_KEY=""

# ── FRED (선택 · pms rates 전용) ──
# ⚠ 사이트는 이 키를 쓰지 않습니다(관측치는 키 없이 받습니다).
#    pms rates verify가 단위·계절조정을 대조할 때만 필요합니다. 무료 발급:
#    https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=""

# ── 한국은행 ECOS (선택) ──
# 한국 기준금리를 자동으로 받는 데 씁니다. 무료 발급: https://ecos.bok.or.kr/api/#/AuthKeyApply
# ⚠ 없으면 `kr_policy_rate` 한 지표만 수집 실패로 남습니다(다른 지표는 그대로 들어옵니다).
# 배포본에는 `npx wrangler secret put ECOS_API_KEY`로 넣습니다.
ECOS_API_KEY=""

# ── 광고 (선택) ──
# Google AdSense 퍼블리셔 ID. 값이 있을 때만 광고 스크립트와 /ads.txt가 나갑니다.
# 형식: ca-pub-0000000000000000
ADSENSE_CLIENT_ID=""

# 광고 자리별 슬롯 ID (AdSense 승인 후 광고 단위를 만들면 나오는 숫자).
# 퍼블리셔 ID와 슬롯 ID가 '둘 다' 있어야 해당 자리에 광고가 그려집니다.
#   article-end     : 인사이트 본문 끝 (가장 값이 높은 자리)
#   feed-end        : 목록 화면 하단
#   content-bottom  : 홈·투자일지 하단
ADSENSE_SLOT_ARTICLE_END=""
ADSENSE_SLOT_FEED_END=""
ADSENSE_SLOT_CONTENT_BOTTOM=""

# 관리자 초기 계정 — 시드가 이 값으로 upsert 합니다(최초 설정값이 그대로 지속).
# 비밀번호를 잊었다면 이 값을 바꾼 뒤 재배포/재시드하면 갱신됩니다. 이메일 복구는 없습니다.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── AI 제공자 (선택) — 키가 존재하는 제공자만 '연결됨'으로 표시·활성화됩니다 ──
# 손으로 채워도 되고, 로컬 개발 서버의 /admin/ai 화면에서 입력하면 프로그램이 여기 써 줍니다.
# 배포본에 반영: npm run ai:sync
# 목록의 출처는 src/lib/ai/catalog.ts 입니다(추가하면 여기에도 한 줄 넣으세요).
# 무료 우선
NVIDIA_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
# 유료(폴백·고급 분석용) — 싼 것부터 시도합니다
DEEPSEEK_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ── 소셜 로그인 (선택, Phase 2) ──
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""
