{
  "name": "woodsman-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:migrate": "prisma migrate dev",
    "db:setup": "npm run db:migrate:local && npm run db:seed",
    "db:migrate:local": "wrangler d1 migrations apply woodsman-db --local",
    "db:seed": "npm run d1:seed:generate && wrangler d1 execute woodsman-db --local --file=./prisma/seed.d1.sql -y",
    "cf:setup": "node --env-file=.env --import tsx scripts/cf-setup.mjs",
    "ai:sync": "node --env-file=.env --import tsx scripts/sync-ai-secrets.mjs",
    "admin:set": "node --env-file=.env --import tsx scripts/set-admin.mjs",
    "admin:apply": "node --env-file=.env --import tsx scripts/set-admin.mjs --from-env",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:migrate": "wrangler d1 migrations apply woodsman-db --remote",
    "d1:seed:generate": "node --env-file=.env --import tsx scripts/generate-d1-seed.mjs",
    "d1:seed": "npm run d1:seed:generate && wrangler d1 execute woodsman-db --remote --file=./prisma/seed.d1.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "bcryptjs": "^3.0.3",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.22",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
